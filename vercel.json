{
  "version": 2,
  "builds": [
    {
      "src": "django_ec_backend/backend/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "django_ec_backend/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "django_ec_backend/backend/wsgi.py"
    }
  ]
}
