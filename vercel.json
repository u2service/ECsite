{
  "version": 2,
  "builds": [
    {
      "src": "nextjs_ec_frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "django_ec_backend/backend/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15 }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "django_ec_backend/backend/wsgi.py"
    },
    {
      "source": "/admin/:path*",
      "destination": "django_ec_backend/backend/wsgi.py"
    },
    {
      "source": "/static/:path*",
      "destination": "django_ec_backend/backend/wsgi.py"
    },
    {
      "source": "/media/:path*",
      "destination": "django_ec_backend/media/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "nextjs_ec_frontend/_next/:path*"
    },
    {
      "source": "/:path*",
      "destination": "nextjs_ec_frontend/:path*"
    }
  ]
}