{
  "version": 2,
  "builds": [
    {
      "src": "nextjs_ec_frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "django_ec_backend/backend/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 15,
        "installCommand": "pip install -r requirements.txt && python django_ec_backend/manage.py migrate"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "django_ec_backend/backend/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "django_ec_backend/backend/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "django_ec_backend/backend/wsgi.py"
    },
    {
      "src": "/media/(.*)",
      "dest": "django_ec_backend/media/$1"
    },
    {
      "src": "/_next/(.*)",
      "dest": "nextjs_ec_frontend/_next/$1"
    },
    {
      "src": "/((?!api|admin|static|media|_next).*)",
      "dest": "nextjs_ec_frontend/"
    }
  ]
}